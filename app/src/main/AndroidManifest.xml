<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android" >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <queries>
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.mm" />
    </queries>

    <application
            android:name=".BotApp"
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:networkSecurityConfig="@xml/network"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Chtholly" tools:targetApi="s">
        <activity
            android:name=".view.FloatWindowActivity"
            android:exported="true" />
        <activity
            android:name=".view.ScanNetActivity"
            android:exported="false" />
        <activity
            android:name=".view.AddCharacterActivity"
            android:exported="true" />
        <activity
            android:name=".view.CharacterActivity"
            android:exported="true" />
        <activity
            android:name=".view.MainActivity"
            android:launchMode="singleTop"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.zinhao.chtholly.view.SetupActivity" android:exported="false" />
        <activity android:name="com.zinhao.chtholly.view.ChatActivity"
                  android:label="@string/chat_page"/>

        <service
            android:name=".NekoChatService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/neko_support"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="com.zinhao.chtholly.fileprovider"
                android:grantUriPermissions="true"
                android:exported="false">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/filepaths" />
        </provider>
    </application>

</manifest>