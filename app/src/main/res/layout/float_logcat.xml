<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent" android:orientation="vertical">
    <TextView
            android:id="@+id/currentChatTitle"
            android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/app_name"
              android:gravity="center"
              android:layout_marginTop="20dp"/>
    <TextView
            android:id="@+id/currentTree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:gravity="center"
            android:layout_marginTop="40dp"/>

    <com.zinhao.chtholly.customview.AccessibilityLogcatView
            android:id="@+id/aclv"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_gravity="bottom"
            android:background="#FF000000"/>
    <com.zinhao.chtholly.customview.VibrationGraphView
        android:id="@+id/vgv" android:layout_width="match_parent" android:layout_height="200dp"/>
</FrameLayout>