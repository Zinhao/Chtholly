<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- 图标 -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/audio_chat_svgrepo_com"
            android:layout_marginBottom="16dp"/>

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="配置语音合成"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择 TTS 服务器和语音风格"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="24dp"/>

        <!-- TTS 预设选择 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/presetTtsLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="选择 TTS 引擎"
            android:layout_marginBottom="16dp">

            <AutoCompleteTextView
                android:id="@+id/presetTtsDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- TTS URL 输入 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ttsUrlLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="TTS 服务器地址"
            app:startIconDrawable="@drawable/link_svgrepo_com"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTtsUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 测试连接按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestTts"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="测试连接"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTestResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:visibility="invisible"/>

        <!-- 语音选择 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/voiceDropdownLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="选择语音"
            app:startIconDrawable="@drawable/audio_chat_svgrepo_com"
            android:layout_marginBottom="8dp">

            <AutoCompleteTextView
                android:id="@+id/voiceDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 自定义 Voice ID -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/customVoiceLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="自定义 Voice ID"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomVoiceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 使用自定义 Voice ID 开关 -->
        <Switch
            android:id="@+id/switchCustomVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="使用自定义 Voice ID"
            android:layout_marginBottom="16dp"/>

        <!-- 高级选项 -->
        <LinearLayout
            android:id="@+id/advancedOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="高级设置"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- 语速 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="语速"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSpeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0.5"
                    android:valueTo="2.0"
                    android:stepSize="0.1"
                    android:value="1.0"/>

                <TextView
                    android:id="@+id/tvSpeedValue"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="1.0x"
                    android:textAlignment="textEnd"/>
            </LinearLayout>

            <!-- 音调 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="音调"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPitch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0.5"
                    android:valueTo="2.0"
                    android:stepSize="0.1"
                    android:value="1.0"/>

                <TextView
                    android:id="@+id/tvPitchValue"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="1.0x"
                    android:textAlignment="textEnd"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 提示信息 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 提示"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 系统默认：使用 Android 系统 TTS\n• Edge TTS：微软在线语音，需网络连接\n• GPT-SoVITS：本地 AI 语音克隆\n• 留空则使用系统默认 TTS"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.2"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>